{
  "mcpServers": {
    "gtm-revops": {
      "command": "uv",
      "args": [
        "run",
        "--package",
        "gtm-revops-ai-automations",
        "gtm-revops-mcp",
        "--stdio"
      ],
      "cwd": "/Users/franck.benichou/projects/personal/repos/gtm-cs-ai-automations"
    },
    "gtm-marketing": {
      "command": "uv",
      "args": [
        "run",
        "--package",
        "gtm-marketing-ai-automations",
        "gtm-marketing-mcp",
        "--stdio"
      ],
      "cwd": "/Users/franck.benichou/projects/personal/repos/gtm-cs-ai-automations"
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/gtm-marketing-ai-automations/hooks/audit.sh"
          }
        ]
      }
    ]
  }
}
